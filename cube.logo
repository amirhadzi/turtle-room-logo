; Real 3D rotation and perspective, drawn with ordinary 2D turtle commands.
; SIN and COS use degrees. WAIT 2 is two sixtieths of a second.

TO PROJECT :X :Y :Z
  (LOCAL "RX "RY "RZ "DEPTH "SCALE)
  MAKE "RX (:X * COS :A) + (:Z * SIN :A)
  MAKE "RZ (:Z * COS :A) - (:X * SIN :A)
  MAKE "RY (:Y * COS :B) - (:RZ * SIN :B)
  MAKE "DEPTH (:Y * SIN :B) + (:RZ * COS :B)
  MAKE "SCALE 400 / (400 + :DEPTH)
  SETXY (:RX * :SCALE) (:RY * :SCALE)
END

TO EDGE :I :J
  (LOCAL "P "Q)
  MAKE "P ITEM :I :VERTICES
  MAKE "Q ITEM :J :VERTICES
  PENUP
  PROJECT (ITEM 1 :P) (ITEM 2 :P) (ITEM 3 :P)
  PENDOWN
  PROJECT (ITEM 1 :Q) (ITEM 2 :Q) (ITEM 3 :Q)
END

TO SPINCUBE
  (LOCAL "A "B "VERTICES "EDGES "PAIR)
  MAKE "VERTICES [
    [-90 -90 -90] [90 -90 -90] [90 90 -90] [-90 90 -90]
    [-90 -90 90] [90 -90 90] [90 90 90] [-90 90 90]
  ]
  MAKE "EDGES [
    [1 2] [2 3] [3 4] [4 1]
    [5 6] [6 7] [7 8] [8 5]
    [1 5] [2 6] [3 7] [4 8]
  ]
  MAKE "A 0
  MAKE "B 20
  CLEARSCREEN
  HIDETURTLE
  SETPENCOLOR "cyan
  SETPENSIZE 2
  FOREVER [
    CLEAN
    REPEAT 12 [
      MAKE "PAIR ITEM REPCOUNT :EDGES
      EDGE (ITEM 1 :PAIR) (ITEM 2 :PAIR)
    ]
    WAIT 2
    MAKE "A :A + 2
    MAKE "B :B + 1
  ]
END

SPINCUBE
